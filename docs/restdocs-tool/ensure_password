DIR="${BASH_SOURCE%/*}"

if [ ! -e "$DIR/restdocs.properties" ]; then
  1>&2 echo "Restdocs properties missing, expected at '$DIR/restdocs.properties'"
  exit 1
fi

CONFIG_FILE="$DIR/restdocs.config"
PASSWORD_KEY="tools-downloader-password"
password=""

if [ -f "$CONFIG_FILE" ]; then
    password=$(grep "^$PASSWORD_KEY=" "$CONFIG_FILE" | cut -d'=' -f2)
fi

if [ -z "$password" ]; then
    echo -n "Enter password for tools-downloader: "
    read -s password
    echo
    if [ -z "$password" ]; then
        >&2 echo "No password provided. Aborting."
        exit 1
    fi
    echo "$PASSWORD_KEY=$password" > "$CONFIG_FILE"
fi